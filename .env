# CombineTuition - Environment Variables
PORT=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nodemailer / SMTP Email Notification System
# Configure your SMTP credentials below to send live emails (e.g. Gmail App Password, SendGrid, Amazon SES, Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CombineTuition Community" <no-reply@combinetution.com>
APP_BASE_URL=http://localhost:3000
